# Local development only. Use Render environment secrets for deployment.
PORT=10000
# Generate independent values, each at least 32 characters. Never use an Azure key here.
APIKEY=
SESSION_SIGNING_SECRET=
# Azure resource origins only: no /openai/v1 path, query or trailing credentials.
AZURE_LIVE_ENDPOINT=https://your-voice-resource.openai.azure.com
AZURE_LIVE_API_KEY=
AZURE_LIVE_DEPLOYMENT=gpt-live-1
AZURE_RESPONSES_ENDPOINT=https://your-text-resource.openai.azure.com
AZURE_RESPONSES_API_KEY=
AZURE_RESPONSES_DEPLOYMENT=gpt-5.6-luna
# Enable only after verifying Azure web_search support and its additional costs.
ENABLE_WEB_SEARCH=false
